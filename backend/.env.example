# ---------------------------------------------------------------------------
# Tramex API configuration
# Copy this file to backend/.env and fill in the real values.
# NEVER commit the real .env to the repository.
# ---------------------------------------------------------------------------

# Runtime environment: development | staging | production.
# In production the application refuses to start with example values, open
# CORS, cookies without Secure, or without Redis configured.
APP_ENV=development

# -- Database ----------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:postgres_password@localhost:5434/tramex

# -- Client credential encryption ------------------------------------
# Fernet (AES-128) key used to encrypt client account passwords.
# Generate it with: python etl/generate_key.py
# In production it must live in a secrets manager, not a loose file: whoever
# has this key and a database dump has every credential.
# Rotating it requires re-encrypting the database; changing the value alone
# isn't enough.
TRAMEX_FERNET_KEY=

# -- Sessions ---------------------------------------------------------------
# Key used to sign the JWTs. Generate it with: openssl rand -hex 32
API_SECRET_KEY=
# Session duration in minutes (480 = one workday).
TOKEN_EXPIRA_MINUTOS=480
# Requires HTTPS to send the session cookie. Mandatory in production.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# bcrypt cost factor. Do not go below 12 in production.
BCRYPT_RONDAS=12

# -- First administrator ---------------------------------------------------
# Seeded when the container starts. If you don't set the password, in
# development one is generated and printed to the console once; in
# production it's required (a password printed in the logs is a leaked
# password).
ADMIN_INICIAL_CORREO=admin@example.com
ADMIN_INICIAL_CONTRASENA=

# -- CORS -------------------------------------------------------------------
# Authorized origins, comma-separated. In production '*' is not accepted:
# the API responds with credentials and the wildcard would expose them to
# any site.
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080

# -- Brute-force protection -----------------------------------------
INTENTOS_MAXIMOS_LOGIN=5
VENTANA_BLOQUEO_MINUTOS=15
# Redis shares the counters across replicas. Mandatory in production: without
# it, each replica counts on its own and the lockout is bypassed by rotating.
REDIS_URL=redis://localhost:6379

# -- Personal data retention ------------------------------------------
# Days a record stays archived before it can be destroyed.
DIAS_RETENCION=365

# -- Observability ---------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=INFO
