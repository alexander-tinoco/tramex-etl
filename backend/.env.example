# URL de conexión a la base de datos PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres_password@localhost:5434/tramex

# Llave de cifrado Fernet (AES) para contraseñas de las cuentas
TRAMEX_FERNET_KEY=YOUR_FERNET_KEY_HERE

# Llave secreta para firmar tokens JWT (Cambiar en producción)
API_SECRET_KEY=YOUR_JWT_SECRET_KEY_HERE

# Credenciales administrativas por defecto para la API
API_USERNAME=admin
API_PASSWORD=changeme
