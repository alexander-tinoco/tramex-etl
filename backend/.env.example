# ---------------------------------------------------------------------------
# Configuracion de la API de Tramex
# Copia este archivo como backend/.env y rellena los valores reales.
# NUNCA subas el .env real al repositorio.
# ---------------------------------------------------------------------------

# Entorno de ejecucion: development | staging | production.
# En production la aplicacion se niega a arrancar con valores de ejemplo,
# CORS abierto, cookies sin Secure o sin Redis configurado.
APP_ENV=development

# -- Base de datos ----------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:postgres_password@localhost:5434/tramex

# -- Cifrado de credenciales de clientes ------------------------------------
# Llave Fernet (AES-128) con la que se cifran las contrasenas de las cuentas
# de los clientes. Generala con: python etl/generate_key.py
# En produccion debe vivir en un gestor de secretos, no en un archivo suelto:
# quien tenga esta llave y un volcado de la base tiene todas las credenciales.
# Rotarla exige re-cifrar la base; no basta con cambiar el valor.
TRAMEX_FERNET_KEY=

# -- Sesiones ---------------------------------------------------------------
# Clave con la que se firman los JWT. Generala con: openssl rand -hex 32
API_SECRET_KEY=
# Duracion de la sesion en minutos (480 = una jornada laboral).
TOKEN_EXPIRA_MINUTOS=480
# Exige HTTPS para enviar la cookie de sesion. Obligatorio en produccion.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Coste de bcrypt. No bajar de 12 en produccion.
BCRYPT_RONDAS=12

# -- Primer administrador ---------------------------------------------------
# Se siembra al arrancar el contenedor. Si no defines la contrasena, en
# desarrollo se genera una y se imprime una sola vez por consola; en produccion
# es obligatoria (una contrasena impresa en los logs es una contrasena filtrada).
ADMIN_INICIAL_CORREO=admin@example.com
ADMIN_INICIAL_CONTRASENA=

# -- CORS -------------------------------------------------------------------
# Origenes autorizados, separados por comas. En produccion no se admite '*':
# la API responde con credenciales y el comodin las expondria a cualquier sitio.
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080

# -- Proteccion contra fuerza bruta -----------------------------------------
INTENTOS_MAXIMOS_LOGIN=5
VENTANA_BLOQUEO_MINUTOS=15
# Redis comparte los contadores entre replicas. Obligatorio en produccion:
# sin el, cada replica cuenta por su cuenta y el bloqueo se elude rotando.
REDIS_URL=redis://localhost:6379

# -- Retencion de datos personales ------------------------------------------
# Dias que un registro permanece archivado antes de poder destruirse.
DIAS_RETENCION=365

# -- Observabilidad ---------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=INFO
