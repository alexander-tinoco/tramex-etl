{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "Tramex — API and sensitive-data access",
  "uid": "tramex-api",
  "tags": ["tramex"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "Traffic and health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Requests per second, by route",
      "description": "Request rate grouped by route template.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (ruta) (rate(tramex_peticiones_total[5m]))",
          "legendFormat": "{{ruta}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency (50th, 95th and 99th percentiles)",
      "description": "Percentiles computed over the duration histogram.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 0 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(tramex_duracion_peticiones_segundos_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tramex_duracion_peticiones_segundos_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(tramex_duracion_peticiones_segundos_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error rate (5xx)",
      "description": "Share of 5xx responses out of the total.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(tramex_peticiones_total{codigo=~\"5..\"}[5m])) / clamp_min(sum(rate(tramex_peticiones_total[5m])), 0.001)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Responses by status code",
      "gridPos": { "h": 5, "w": 18, "x": 6, "y": 9 },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 1, "fillOpacity": 25, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (codigo) (rate(tramex_peticiones_total[5m]))",
          "legendFormat": "{{codigo}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Security and sensitive data",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },
    {
      "type": "timeseries",
      "title": "Client credentials decrypted",
      "description": "Each point corresponds to an entry in logs_auditoria. A sustained spike is worth reviewing in the audit log.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 20 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (recurso) (rate(tramex_credenciales_consultadas_total[15m]) * 60)",
          "legendFormat": "{{recurso}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Sign-in attempts",
      "description": "A rise in 'failed' or any 'account_locked' points to a brute-force attempt.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 20 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (resultado) (rate(tramex_intentos_login_total[5m]) * 60)",
          "legendFormat": "{{resultado}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Credentials decrypted (24 h)",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "sum(increase(tramex_credenciales_consultadas_total[24h]))", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Failed logins (1 h)",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 30 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(tramex_intentos_login_total{resultado=\"failed\"}[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Locked accounts (24 h)",
      "description": "Any value other than zero is worth a look at the audit log.",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(tramex_intentos_login_total{resultado=~\"account_locked|blocked_by_ip\"}[24h]))",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
