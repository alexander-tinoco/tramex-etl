# ---------------------------------------------------------------------------
# ETL pipeline configuration
# Copy this file to etl/.env and fill in the real values.
# NEVER commit the real .env to the repository.
# ---------------------------------------------------------------------------

# Database connection. There's no SQLite fallback: if this variable is
# missing the pipeline stops, instead of writing to a local file and giving
# the impression the real database was loaded.
DATABASE_URL=postgresql+psycopg2://postgres:postgres_password@localhost:5434/tramex

# Fernet key used to encrypt client account credentials. It must be exactly
# the same one the API uses: if they differ, the API won't be able to
# decrypt what the ETL loaded.
# Generate it with: python etl/generate_key.py
TRAMEX_FERNET_KEY=
