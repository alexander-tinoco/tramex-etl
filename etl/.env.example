# Copia este archivo como .env y llénalo con tus valores reales.
# NUNCA subas el .env real a un repositorio.

# Cadena de conexión a PostgreSQL. Ejemplo:
DATABASE_URL=postgresql+psycopg2://usuario:password@localhost:5432/tramex

# Llave de cifrado generada con generate_key.py
# En producción, esto debería vivir en un gestor de secretos
# (Vaultwarden, HashiCorp Vault, etc.), no en un archivo .env suelto.
TRAMEX_FERNET_KEY=
