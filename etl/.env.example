# ---------------------------------------------------------------------------
# Configuracion del pipeline ETL
# Copia este archivo como etl/.env y rellena los valores reales.
# NUNCA subas el .env real al repositorio.
# ---------------------------------------------------------------------------

# Conexion a la base de datos. No hay respaldo a SQLite: si falta esta
# variable el pipeline se detiene, en lugar de escribir en un archivo local
# haciendo creer que cargo la base real.
DATABASE_URL=postgresql+psycopg2://postgres:postgres_password@localhost:5434/tramex

# Llave Fernet con la que se cifran las credenciales de las cuentas de los
# clientes. Debe ser exactamente la misma que usa la API: si difieren, la API
# no podra descifrar lo que cargue el ETL.
# Generala con: python etl/generate_key.py
TRAMEX_FERNET_KEY=
